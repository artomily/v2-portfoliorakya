---
// Main Card wrapper component
export interface Props {
  className?: string;
}

const { 
  className = "" 
} = Astro.props;
---

<div class={`bg-white rounded-xl shadow-2xl overflow-hidden ${className}`}>
  <slot />
</div>

<style>
  /* Custom animations for card */
  div {
    transition: all 0.3s ease-in-out;
  }
  
  div:hover {
    transform: translateY(-2px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }
</style>